FROM php:8.2-apache

RUN apt-get update && apt-get install -y \
    git \
    curl \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    libsqlite3-dev \
    sqlite3 \
    zip \
    unzip \
    && docker-php-ext-install zip pdo_mysql pdo_sqlite mbstring exif pcntl bcmath gd \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV APACHE_DOCUMENT_ROOT /var/www/html/public

RUN a2enmod rewrite
RUN mkdir -p ${APACHE_DOCUMENT_ROOT}

RUN sed -ri -e "s!/var/www/html!${APACHE_DOCUMENT_ROOT}!g" /etc/apache2/sites-available/*.conf

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs

COPY package*.json ./

RUN npm install

COPY . .

RUN npm run build

WORKDIR /var/www/html
COPY . .

RUN chown -R www-data:www-data ${APACHE_DOCUMENT_ROOT} \
    /var/www/html/storage /var/www/html/bootstrap/cache

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer
RUN composer install --no-dev --optimize-autoloader

ENV PORT 80
RUN sed -i "s/Listen 80/Listen ${PORT}/" /etc/apache2/ports.conf
EXPOSE ${PORT}

CMD if [ -f "/var/www/html/database/database.sqlite" ]; then touch "/var/www/html/database/database.sqlite"; fi && \
    php artisan migrate

CMD ["apache2-foreground"]
